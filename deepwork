def edit_config(cfg):
    """Open the settings file in $VISUAL/$EDITOR (else nvim, vim, vi); write the defaults first if missing."""
    if not os.path.exists(cfg.config):
        os.makedirs(os.path.dirname(cfg.config), exist_ok=True)
        write_json(cfg.config, cfg.conf)
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or next(
        (e for e in ("nvim", "vim", "vi") if shutil.which(e)), "vi")
    while True:
        subprocess.run(editor + " " + shlex.quote(cfg.config), shell=True)
        try:
            with open(cfg.config) as f:
                json.load(f)
            return print("Saved %s. Takes effect on the next deepwork start." % cfg.config)
        except ValueError as e:
            if not yes("That isn't valid JSON (%s). Edit again?" % e):
                return print("Left as is; deepwork uses the defaults until it parses.")

def main(argv):
    dry = "--dry-run" in argv
    assume_yes = "-y" in argv or "--yes" in argv
    everyone = "--all" in argv
    goal = None
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-g", "--goal") and i + 1 < len(argv):
            goal = argv[i + 1]
            i += 2
            continue
        if a not in ("--dry-run", "-y", "--yes", "--all"):
            rest.append(a)
        i += 1
    cfg = Cfg(dry)
    cmd = rest[0] if rest else str(DEFAULT_MIN)
    if cmd == "_watchdog":
        return watchdog(cfg)
    if cmd == "_finish":
        return finish(cfg, rest[1], rest[2])
    if cmd == "off":
        return off(cfg, assume_yes)
    if cmd == "status":
        return status(cfg)
    if cmd in ("stats", "score"):
        return score(cfg, everyone)
    if cmd == "capture":
        text = " ".join(rest[1:]).strip()
        if not text:
            sys.exit('usage: deepwork capture "<thought>"')
        append_capture(cfg, text)
        return print("Captured.")
    if cmd == "break":
        return plan_break(cfg, float(rest[1]) if len(rest) > 1 else 10)
    if cmd == "baseline":
        minutes = float(rest[1]) if len(rest) > 1 else 60
        if minutes <= 0 or (minutes < 1 and not dry):
            sys.exit("minutes must be at least 1")
        return start(cfg, minutes, True, goal, kind="baseline")
    if cmd in ("questions", "edit"):
        return edit_config(cfg)
    if cmd == "config":
        print("# %s%s" % (cfg.config, "" if os.path.exists(cfg.config) else " (not created yet; defaults below)"))
        return print(json.dumps(cfg.conf, indent=2))
    if cmd in ("help", "-h", "--help"):
        return print(__doc__)
    try:
        minutes = float(cmd)
    except ValueError:
        sys.exit("unknown command %r. Try: deepwork help" % cmd)
    if minutes <= 0 or (minutes < 1 and not dry):
        sys.exit("minutes must be at least 1")
    start(cfg, minutes, assume_yes, goal)


if __name__ == "__main__":
    main(sys.argv[1:])
