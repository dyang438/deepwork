# ---------- small helpers ----------

def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=2)
    os.replace(tmp, path)


def read_jsonl(path):
    out = []
    try:
        with open(path) as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except FileNotFoundError:
        pass
    return out


def rm(path):
    try:
        os.remove(path)
    except FileNotFoundError:
        pass


def now():
    return time.time()


def iso(ts):
    return dt.datetime.fromtimestamp(ts).astimezone().isoformat(timespec="seconds")


def hm(ts):
    return dt.datetime.fromtimestamp(ts).strftime("%H:%M")


def ask(prompt, default=""):
    try:
        ans = input(prompt).strip()
    except EOFError:
        ans = ""
    return ans or default


def yes(prompt):
    return ask(prompt + " [y/n] ", "n").lower().startswith("y")


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError, TypeError):
        return False


# ---------- configuration ----------

def load_config(path):
    conf = json.loads(json.dumps(DEFAULT_CONFIG))
    for k, v in (read_json(path) or {}).items():
        if k.endswith("_questions") and isinstance(v, dict) and k in conf:
            conf[k] = {q: v.get(q, False) for q in conf[k]}  # a question deleted from the file is skipped
        elif isinstance(v, dict) and isinstance(conf.get(k), dict):
            conf[k].update(v)
        elif k in conf:
            conf[k] = v
    return conf


class Cfg:
    def __init__(self, dry):
        self.dry = dry
        home = os.path.expanduser("~")
        self.state = os.environ.get("DEEPWORK_HOME", os.path.join(home, ".deepwork-dryrun" if dry else ".deepwork"))
        self.log = os.environ.get("DEEPWORK_LOG", os.path.join(self.state, "log.jsonl"))
        self.capture = os.environ.get("DEEPWORK_CAPTURE", os.path.join(self.state, "capture.md"))
        self.sessions = os.path.join(self.state, "sessions")
        self.port = int(os.environ.get("DEEPWORK_PORT", "47616" if dry else "47615"))
        self.who = os.environ.get("DEEPWORK_WHO", os.environ.get("USER", "unknown"))
        self.session = os.path.join(self.state, "session.json")
        self.pending = os.path.join(self.state, "pending.json")
        self.actions = os.path.join(self.state, "actions.log")
        self.wdlog = os.path.join(self.state, "watchdog.log")
        self.config = os.environ.get("DEEPWORK_CONFIG", os.path.join(
            os.environ.get("DEEPWORK_HOME", os.path.join(home, ".deepwork")), "config.json"))
        self.conf = load_config(self.config)
        self.apps = list(self.conf["quit_apps"])
        self.tracking = bool(self.conf["tracking"])
        # Dry runs never touch the configured database; tests point one in through the environment.
        self.database_url = os.environ.get("DEEPWORK_DATABASE_URL") or (None if dry else self.conf["database_url"])
        self.credentials = os.path.join(os.path.dirname(self.config), "credentials.json")
        self.web = Web(self)
        self.store = Store(self)

    def ensure_dirs(self):
        os.makedirs(self.sessions, exist_ok=True)
        for p in (self.log, self.capture):
            os.makedirs(os.path.dirname(p), exist_ok=True)


# ---------- deepwork.garden: sign in once, then sessions start and land on the web dashboard ----------

class Web:
    """Talks to deepwork.garden with the token from `deepwork login`. Every call is best effort: the local log is
    the source of truth, and the whole log is re-sent (idempotently) on the next sync."""

    def __init__(self, cfg):
        self.path = cfg.credentials
        creds = read_json(self.path) or {}
        self.server = os.environ.get("DEEPWORK_SERVER") or creds.get("server")
        # Dry runs never touch the real account; tests point a server in through the environment.
        self.token = creds.get("token") if (not cfg.dry or os.environ.get("DEEPWORK_SERVER")) else None

    @property
    def enabled(self):
        return bool(self.server and self.token)

    def call(self, method, path, body=None, token=True, timeout=8, headers=None):
        req = urllib.request.Request(self.server.rstrip("/") + path, method=method,
                                     data=None if body is None else json.dumps(body).encode(),
                                     headers={"Content-Type": "application/json", "User-Agent": "deepwork-cli",
                                              **(headers or {})})
        if token:
            req.add_header("Authorization", "Bearer " + self.token)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.status, json.loads(r.read() or b"{}")
        except urllib.error.HTTPError as e:
            if e.code == 401 and token:
                raise RuntimeError("deepwork.garden no longer accepts this terminal; run: deepwork login")
            return e.code, json.loads(e.read() or b"{}")

    def active(self, s):
        self.call("PUT", "/api/cli/active", {"goal": s.get("goal") or "(none given)", "started_at": iso(s["start"]),
                                             "ends_at": iso(s["end"])}, timeout=4)

    def clear(self):
        self.call("DELETE", "/api/cli/active", timeout=4)

    def sync(self, records):
        rows = [{"id": str(uuid.uuid5(uuid.NAMESPACE_URL, "deepwork:" + record_id(r))),
                 "goal": (r.get("goal") or "(none given)")[:200], "minutes": int(round(float(r.get("minutes") or 0))),
                 "outcome": r.get("outcome") if r.get("outcome") in ("done", "partial", "not done") else "unrecorded",
                 "started_at": r["start"], "focus_pct": r.get("focus_pct")}
                for r in records if r.get("kind", "deep") == "deep" and r.get("start")]
        code, body = self.call("POST", "/api/cli/sessions", {"sessions": rows}, timeout=20)
        if code != 200:
            raise RuntimeError("deepwork.garden refused the upload (%s): %s" % (code, body.get("error")))
        return body["synced"]


def login(cfg, server):
    web = cfg.web
    web.server = server
    code, start_ = web.call("POST", "/api/cli/login", token=False)
    if code != 200:
        sys.exit("Couldn't reach %s (%s)." % (server, code))
    print("Your code: %s" % start_["user_code"], flush=True)
    print("Confirm it in your browser: %s" % start_["verification_url"], flush=True)
    if not cfg.dry and not os.environ.get("DEEPWORK_NO_BROWSER"):
        subprocess.run(["open", start_["verification_url"]], capture_output=True)
    deadline = now() + start_["expires_in"]
    while now() < deadline:
        time.sleep(start_.get("interval", 2))
        code, body = web.call("POST", "/api/cli/token", {"device_code": start_["device_code"]}, token=False)
        if code == 200 and body.get("token"):
            break
        if code != 202:
            sys.exit("Login failed: %s" % body.get("error", code))
    else:
        sys.exit("Login timed out. Run deepwork login again.")
    os.makedirs(os.path.dirname(cfg.credentials), exist_ok=True)
    fd = os.open(cfg.credentials, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"server": server, "token": body["token"]}, f)
    web.token = body["token"]
    print("Connected as %s." % web.call("GET", "/api/cli/whoami")[1].get("email"))
    if cfg.store.local():
        print("Uploaded %d past session(s)." % web.sync(cfg.store.local()))
    if not os.path.exists(AGENT_PLIST):
        print("Next: deepwork agent install, so + on deepwork.garden starts blocks on this Mac.")


AGENT_LABEL = "garden.deepwork.agent"
AGENT_PLIST = os.path.expanduser("~/Library/LaunchAgents/%s.plist" % AGENT_LABEL)


def agent(cfg):
    """Long-running: poll deepwork.garden for start/stop commands from the dashboard and run them on this Mac."""
    every = float(os.environ.get("DEEPWORK_AGENT_EVERY", "3"))
    me = [sys.executable, os.path.realpath(__file__)] + (["--dry-run"] if cfg.dry else [])
    print("%s agent up on %s" % (iso(now()), socket.gethostname()), flush=True)
    while True:
        cfg.web = Web(cfg)  # re-read credentials, so a new `deepwork login` is picked up
        if not cfg.web.enabled:
            print("%s not connected; run deepwork login" % iso(now()), flush=True)
            time.sleep(30)
            continue
        try:
            cmd = cfg.web.call("POST", "/api/cli/agent", {}, timeout=10,
                               headers={"X-Deepwork-Host": socket.gethostname()})[1].get("command")
        except Exception as e:
            print("%s poll failed: %s" % (iso(now()), e), flush=True)
            time.sleep(max(every, 10))
            continue
        if cmd and cmd["kind"] == "start":
            if os.path.exists(cfg.session):
                print("%s start ignored: a session is already running" % iso(now()), flush=True)
            else:
                print("%s start %s min: %s" % (iso(now()), cmd["minutes"], cmd["goal"]), flush=True)
                subprocess.run(me + [str(cmd["minutes"]), "-y", "-d", "--from-web", "-g", cmd["goal"]],
                               stdin=subprocess.DEVNULL, timeout=120)
        elif cmd and cmd["kind"] == "stop":
            print("%s stop" % iso(now()), flush=True)
            subprocess.run(me + ["off", "-y"], stdin=subprocess.DEVNULL, timeout=120)
        time.sleep(every)


def agent_ctl(cfg, action):
    uid = str(os.getuid())
    if action == "install":
        if not cfg.web.enabled:
            sys.exit("Connect first: deepwork login")
        os.makedirs(os.path.dirname(AGENT_PLIST), exist_ok=True)
        log = os.path.join(cfg.state, "agent.log")
        args = "".join("<string>%s</string>" % a for a in (sys.executable, os.path.realpath(__file__), "agent"))
        with open(AGENT_PLIST, "w") as f:
            f.write("""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>%s</string>
  <key>ProgramArguments</key><array>%s</array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>%s</string>
  <key>StandardErrorPath</key><string>%s</string>
</dict></plist>
""" % (AGENT_LABEL, args, log, log))
        subprocess.run(["launchctl", "bootout", "gui/%s/%s" % (uid, AGENT_LABEL)], capture_output=True)
        r = subprocess.run(["launchctl", "bootstrap", "gui/" + uid, AGENT_PLIST], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit("launchctl couldn't start the agent: %s" % r.stderr.strip())
        return print("Agent installed: + on deepwork.garden now starts blocks on this Mac. Log: %s" % log)
    if action == "uninstall":
        subprocess.run(["launchctl", "bootout", "gui/%s/%s" % (uid, AGENT_LABEL)], capture_output=True)
        rm(AGENT_PLIST)
        return print("Agent removed.")
    if action == "status":
        r = subprocess.run(["launchctl", "print", "gui/%s/%s" % (uid, AGENT_LABEL)], capture_output=True, text=True)
        state = re.search(r"state = (\w+)", r.stdout)
        return print("Agent: %s" % (state.group(1) if state else "not installed"))
    return agent(cfg)


# ---------- storage: a local log, mirrored to Postgres when database_url is set ----------

TABLE_SQL = """create table if not exists deepwork_sessions (
  id text primary key, who text not null, started_at timestamptz not null, record jsonb not null);"""


def record_id(r):
    return r.get("id") or "%s/%s" % (r.get("who"), r.get("start"))


class Store:
    """The local log is always written first, so a session is never lost to a network problem.
    With a database, sync() upserts the whole log (idempotent) and stats read from the database."""

    def __init__(self, cfg):
        self.log = cfg.log
        self.url = cfg.database_url
        self.web = cfg.web

    def local(self):
        return read_jsonl(self.log)

    def add(self, rec):
        with open(self.log, "a") as f:
            f.write(json.dumps(rec) + "\n")
        notes = []
        if self.url:
            try:
                notes.append("Synced %d session(s) to the database." % self.sync())
            except Exception as e:
                notes.append("Database sync failed (%s); saved locally, retried on the next sync." % e)
        if self.web.enabled:
            try:
                self.web.sync(self.local())
                notes.append("On your deepwork.garden dashboard.")
            except Exception as e:
                notes.append("deepwork.garden sync failed (%s); saved locally, retried on the next sync." % e)
        return "\n".join(notes)

    def records(self):
        if not self.url:
            return self.local()
        try:
            self.sync()
            out = self.psql("select record::text from deepwork_sessions order by started_at;")
            return [json.loads(line) for line in out.splitlines() if line.strip()]
        except Exception as e:
            print("(database unreachable: %s; showing the local log)" % e, file=sys.stderr)
            return self.local()

    def sync(self):
        rows = list({record_id(r): dict(r, id=record_id(r)) for r in self.local()}.values())  # last copy wins
        if not rows:
            self.psql(TABLE_SQL)
            return 0
        data = json.dumps(rows)
        tag = "$dw$"
        while tag in data:
            tag = "$dw%d$" % len(tag)
        self.psql(TABLE_SQL + """
insert into deepwork_sessions (id, who, started_at, record)
select r->>'id', r->>'who', (r->>'start')::timestamptz, r from jsonb_array_elements(%s%s%s::jsonb) r
on conflict (id) do update set record = excluded.record, who = excluded.who, started_at = excluded.started_at;"""
                  % (tag, data, tag))
        return len(rows)

    def psql(self, sql):
        if not shutil.which("psql"):
            raise RuntimeError("psql not found (brew install libpq)")
        r = subprocess.run(["psql", self.url, "-X", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1"],
                           input=sql, capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip().splitlines()[-1] if r.stderr.strip() else "psql failed")
        return r.stdout


# ---------- side effects (all routed through act) ----------

def act(cfg, kind, *args):
    """Run a system action, or record it when dry."""
    if cfg.dry:
        with open(cfg.actions, "a") as f:
            f.write("%s %s %s\n" % (iso(now()), kind, " ".join(args)))
        return
    run = lambda *cmd, t=10: subprocess.run(list(cmd), capture_output=True, timeout=t)
    running = lambda app: subprocess.run(["pgrep", "-xq", app]).returncode == 0
    try:
        if kind == "quit":
            if running(args[0]):
                run("osascript", "-e", 'quit app "%s"' % args[0])
        elif kind == "open":
            run("open", "-g", "-a", args[0])
        elif kind == "shortcut":
            names = subprocess.run(["shortcuts", "list"], capture_output=True, text=True, timeout=15).stdout
            if args[0] in names.splitlines():
                run("shortcuts", "run", args[0], t=30)
        elif kind == "notify":
            snd = cfg.conf["sounds"].get("notify")
            run("osascript", "-e", 'display notification "%s" with title "deepwork"%s' % (
                args[0].replace('"', "'"), ' sound name "%s"' % snd if snd else ""))
        elif kind == "sound":
            subprocess.Popen(["afplay", "/System/Library/Sounds/%s.aiff" % args[0]],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif kind == "music_pause":
            if shutil.which("media-control"):
                run("media-control", "pause")
            for app in ("Spotify", "Music"):
                if running(app):
                    run("osascript", "-e", 'tell application "%s" to pause' % app)
        elif kind == "terminal":
            # Opening a .command file needs no Automation permission (no AppleScript).
            if run("open", args[0], t=30).returncode != 0:
                act(cfg, "notify", "Session over. Open a terminal and run: deepwork off")
    except Exception as e:  # never let a side effect crash the session
        sys.stderr.write("deepwork: %s failed: %s\n" % (kind, e))


def running_apps(cfg):
    if cfg.dry:
        return list(cfg.apps)
    return [a for a in cfg.apps if subprocess.run(["pgrep", "-xq", a]).returncode == 0]


def shutdown_command(cfg):
    """Write shutdown.command; Terminal runs it when it is opened."""
    path = os.path.join(cfg.state, "shutdown.command")
    with open(path, "w") as f:
        f.write("#!/bin/zsh\n'%s' off%s\n" % (os.path.realpath(__file__), " --dry-run" if cfg.dry else ""))
    os.chmod(path, 0o755)
    return path


# ---------- session lifecycle ----------

def start(cfg, minutes, assume_yes, goal, detach=False, from_web=False):
    cfg.ensure_dirs()
    if os.path.exists(cfg.session):
        s = read_json(cfg.session) or {}
        sys.exit("A session is already running until %s. Use: deepwork status / deepwork off" % hm(s.get("end", 0)))
    if os.path.exists(cfg.pending):
        print("The last session never got its shutdown. Doing that first.")
        shutdown(cfg, assume_yes)

    start_ts = now()
    end_ts = start_ts + minutes * 60
    deadline, checklist, answers = hm(end_ts), {}, {}
    if not assume_yes:
        q = cfg.conf["start_questions"]
        if q.get("goal"):
            goal = goal or ask(q["goal"])
        if q.get("deadline"):
            suggested = hm(start_ts + minutes * 60 * 0.8)
            deadline = ask(q["deadline"].format(suggested=suggested), suggested)
        items = [it if isinstance(it, str) else it["item"] for it in q.get("checklist") or []
                 if isinstance(it, str) or minutes > it.get("over_minutes", 0)]
        if items:
            print("Support checklist:")
        for it in items:
            checklist[it] = yes("  %s?" % it)
        for c in q.get("custom") or []:
            answers[c] = ask(c.rstrip() + " ")
    session = {
        "who": cfg.who, "start": start_ts, "end": end_ts, "planned_minutes": minutes,
        "goal": goal or "(none given)", "deadline": deadline, "checklist": checklist or "skipped",
        "answers": answers, "apps_running": running_apps(cfg),
        "samples_path": os.path.join(cfg.sessions, dt.datetime.fromtimestamp(start_ts).strftime("%Y-%m-%dT%H%M%S") + ".jsonl"),
    }
    write_json(cfg.session, session)
    for a in cfg.apps:
        act(cfg, "quit", a)
    if cfg.conf.get("music_pause"):
        act(cfg, "music_pause")
    if cfg.conf["sounds"].get("start"):
        act(cfg, "sound", cfg.conf["sounds"]["start"])
    act(cfg, "shortcut", SHORTCUT_ON)
    foreground = not detach and sys.stdin.isatty() and sys.stdout.isatty()
    if from_web:
        session["from_web"] = True  # nobody is at a terminal: the watchdog logs it when it ends
    if foreground:
        session["fg_pid"] = os.getpid()  # the watchdog leaves the shutdown to this terminal while it is alive
    session["watchdog_pid"] = spawn_watchdog(cfg)
    write_json(cfg.session, session)
    print("Deep work until %s (%g min). Goal: %s%s" % (hm(end_ts), minutes, session["goal"],
                                                       "  [dry run]" if cfg.dry else ""))
    if not foreground:
        return print('Stray thought? deepwork capture "..."   Stop early: deepwork off')
    print('Stray thought? deepwork capture "..." from another terminal.   Ctrl-C ends early.')
    wait_here(cfg, session, assume_yes)


def wait_here(cfg, s, assume_yes):
    """Count down in this terminal, then run the shutdown questions here when the watchdog ends the block."""
    try:
        while os.path.exists(cfg.session):
            left = max(0, s["end"] - now())
            sys.stdout.write("\r  %s left   " % ("%d:%02d:%02d" % (left // 3600, left % 3600 // 60, left % 60)
                                                if left >= 3600 else "%02d:%02d" % (left // 60, left % 60)))
            sys.stdout.flush()
            time.sleep(1)
    except KeyboardInterrupt:
        print("\nEnding early.")
        return off(cfg, assume_yes)
    print("\a")  # bell: time is up
    if os.path.exists(cfg.pending):
        shutdown(cfg, assume_yes)


def claim_and_restore(cfg, ended_by):
    """Atomically move session.json to pending.json; only the winner restores the machine."""
    try:
        os.rename(cfg.session, cfg.pending)
    except FileNotFoundError:
        return False
    s = read_json(cfg.pending) or {}
    s.update(ended=now(), ended_by=ended_by)
    write_json(cfg.pending, s)
    if cfg.web.enabled:
        try:
            cfg.web.clear()
        except Exception as e:
            sys.stderr.write("deepwork: couldn't clear the live session on deepwork.garden: %s\n" % e)
    act(cfg, "shortcut", SHORTCUT_OFF)
    for a in s.get("apps_running", cfg.apps):
        act(cfg, "open", a)
    return True


def off(cfg, assume_yes):
    cfg.ensure_dirs()
    s = read_json(cfg.session)
    if s:
        pid = s.get("watchdog_pid")
        if pid and pid != os.getpid() and pid_alive(pid):
            os.kill(pid, signal.SIGTERM)
            for _ in range(30):
                if not pid_alive(pid):
                    break
                time.sleep(0.1)
        claim_and_restore(cfg, "off")
    if not os.path.exists(cfg.pending):
        return print("No session to shut down.")
    shutdown(cfg, assume_yes)


def shutdown(cfg, assume_yes):
    # Claim the pending session atomically so two shutdowns (the popup and a manual one) never collide.
    claimed = os.path.join(cfg.state, "shutdown-%d.json" % os.getpid())
    try:
        os.rename(cfg.pending, claimed)
    except FileNotFoundError:
        return print("No session to shut down (another shutdown already handled it).")
    try:
        _shutdown(cfg, assume_yes, read_json(claimed) or {})
    except BaseException:
        if not os.path.exists(cfg.pending):
            os.rename(claimed, cfg.pending)  # interrupted: keep it for the next deepwork off
        raise
    rm(claimed)


def _shutdown(cfg, assume_yes, s):
    ended = s.get("ended", now())
    outcome, done, loops, tomorrow, answers = "unrecorded", "", [], "", dict(s.get("answers") or {})
    focus = None
    q = cfg.conf["shutdown_questions"]
    if not assume_yes and any(q.values()):
        print("Session over. Goal was: %s" % s.get("goal"))
        if q.get("outcome"):
            outcome = ask(q["outcome"], "n").lower()
            outcome = {"y": "done", "yes": "done", "p": "partial", "partial": "partial"}.get(outcome, "not done")
        if q.get("done"):
            done = ask(q["done"])
        if q.get("open_loops"):
            print(q["open_loops"])
            while True:
                line = ask("  > ")
                if not line:
                    break
                loops.append(line)
        if q.get("tomorrow"):
            tomorrow = ask(q["tomorrow"])
        if q.get("focus"):
            f = ask(q["focus"]).rstrip("%").strip()
            focus = max(0, min(100, int(f))) if f.isdigit() else None
        for c in q.get("custom") or []:
            answers[c] = ask(c.rstrip() + " ")
    for line in loops:
        append_capture(cfg, line, "open loop")
    start_ts = s.get("start", ended)
    rec = {
        "who": s.get("who", cfg.who), "start": iso(start_ts), "end": iso(ended),
        "minutes": round((ended - start_ts) / 60, 1), "planned_minutes": s.get("planned_minutes"),
        "goal": s.get("goal"), "deadline": s.get("deadline"), "checklist": s.get("checklist"),
        "outcome": outcome, "done": done, "open_loops": loops, "tomorrow": tomorrow, "answers": answers,
        "focus_pct": focus,
        "ended_by": s.get("ended_by", "off"),
        "activity": summarize(read_jsonl(s["samples_path"])) if s.get("samples_path") else None,
    }
    rec["id"] = record_id(rec)
    note = cfg.store.add(rec)
    if rec["activity"]:
        print(session_line(rec))
    if note:
        print(note)
    print("Logged %.0f min. Shutdown complete." % rec["minutes"])


def append_capture(cfg, text, tag="capture"):
    cfg.ensure_dirs()
    with open(cfg.capture, "a") as f:
        f.write("- [%s] (%s) %s\n" % (dt.datetime.now().strftime("%Y-%m-%d %H:%M"), tag, text))


def status(cfg):
    s = read_json(cfg.session)
    if not s:
        return print("Session ended; shutdown not done yet. Run: deepwork off" if os.path.exists(cfg.pending)
                     else "No deep work session.")
    alive = pid_alive(s.get("watchdog_pid"))
    print("Deep work until %s (%.0f min left). Goal: %s" % (hm(s["end"]), max(0, s["end"] - now()) / 60, s["goal"]))
    print("Deadline: %s   Watchdog: %s   Extension endpoint: %s" % (
        s.get("deadline"), "running" if alive else "DEAD", "up" if endpoint_up(cfg) else "down"))
    if not alive:
        s["watchdog_pid"] = spawn_watchdog(cfg)
        write_json(cfg.session, s)
        print("Restarted the watchdog.")


def endpoint_up(cfg):
    import urllib.request
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/state" % cfg.port, timeout=1) as r:
            return json.load(r).get("active") is True
    except Exception:
        return False


# ---------- stats ----------

def summarize(events):
    """Activity summary for one session from its samples file. Domains only; no titles or content."""
    samples = [e for e in events if e.get("type") == "sample"]
    every = samples[0].get("every", SAMPLE_EVERY) if samples else SAMPLE_EVERY
    n = len(samples)
    hours = n * every / 3600 or 1e-9
    act_n = sum(1 for x in samples if x.get("active"))
    longest = run = 0
    for x in samples:
        run = run + 1 if x.get("active") else 0
        longest = max(longest, run)
    apps = collections.Counter(x.get("app") or "?" for x in samples)
    doms = collections.Counter(x["domain"] for x in samples if x.get("app") == CHROME and x.get("domain"))
    app_sw = sum(1 for a, b in zip(samples, samples[1:]) if a.get("app") != b.get("app"))
    seq = [e["domain"] for e in events if e.get("type") == "tab" and e.get("domain")]
    dom_sw = sum(1 for a, b in zip(seq, seq[1:]) if a != b)
    hits = collections.Counter(e.get("domain") or "?" for e in events if e.get("type") == "hit")
    m = lambda k: round(k * every / 60, 1)
    return {
        "samples": n, "sample_every_s": every, "active_min": m(act_n), "idle_min": m(n - act_n),
        "focus_ratio": round(act_n / n, 2) if n else None, "longest_active_min": m(longest),
        "app_switches_per_h": round(app_sw / hours, 1), "domain_switches_per_h": round(dom_sw / hours, 1),
        "top_apps": [[a, m(c)] for a, c in apps.most_common(5)],
        "top_domains": [[d, m(c)] for d, c in doms.most_common(5)],
        "blocked_attempts": dict(hits.most_common()),
    }


def session_line(r):
    a = r.get("activity") or {}
    when = r["start"][:16].replace("T", " ")
    if not a.get("samples"):
        return "  %s  %4.0f min  %s  (no activity data)" % (when, r.get("minutes") or 0, r.get("goal"))
    top = ", ".join("%s %d" % kv for kv in list(a["blocked_attempts"].items())[:3]) or "none"
    return "  %s  %4.0f min  focus %3.0f%%  %4.1f app sw/h  %4.1f site sw/h  longest %4.1f min  blocked: %s  | %s" % (
        when, r.get("minutes") or 0, 100 * (a["focus_ratio"] or 0), a["app_switches_per_h"],
        a["domain_switches_per_h"], a["longest_active_min"], top, r.get("goal"))


def week_line(recs):
    acts = [r["activity"] for r in recs if (r.get("activity") or {}).get("samples")]
    if not acts:
        return "Week: no activity data yet"
    weight = lambda a: a["samples"] * a["sample_every_s"] / 3600
    hours = sum(weight(a) for a in acts) or 1e-9
    hits = collections.Counter()
    for a in acts:
        hits.update(a["blocked_attempts"])
    focus = sum(a["active_min"] for a in acts) / (sum(a["active_min"] + a["idle_min"] for a in acts) or 1e-9)
    return "Week: focus %.0f%%, %.1f app switches/h, %.1f site switches/h, longest stretch %.1f min, top attempts: %s" % (
        100 * focus, sum(a["app_switches_per_h"] * weight(a) for a in acts) / hours,
        sum(a["domain_switches_per_h"] * weight(a) for a in acts) / hours,
        max(a["longest_active_min"] for a in acts), ", ".join("%s %d" % kv for kv in hits.most_common(5)) or "none")


def stats_report(records, who=None, today=None):
    today = today or dt.date.today()
    monday = today - dt.timedelta(days=today.weekday())
    day_m = week_m = 0.0
    per_goal = collections.Counter()
    week = []
    for r in records:
        if (who and r.get("who") != who) or r.get("kind", "deep") != "deep":  # older logs also hold baselines
            continue
        d = dt.datetime.fromisoformat(r["start"]).date()
        m = float(r.get("minutes") or 0)
        if d == today:
            day_m += m
        if monday <= d <= today:
            week_m += m
            week.append(r)
            per_goal[r.get("goal") or "(none)"] += m
    lines = ["Deep hours today:     %.1f" % (day_m / 60),
             "Deep hours this week: %.1f  (since Mon %s)" % (week_m / 60, monday.isoformat())]
    if per_goal:
        lines.append("Per goal this week:")
        lines += ["  %5.1f h  %s" % (m / 60, g) for g, m in per_goal.most_common()]
    if week:
        lines.append("Sessions this week:")
        lines += [session_line(r) for r in week]
        lines.append(week_line(week))
    return "\n".join(lines)


def stats(cfg, everyone):
    print(stats_report(cfg.store.records(), None if everyone else cfg.who))
    s = read_json(cfg.session)
    if s:
        print("(in progress: %.0f min so far, not counted yet)" % ((now() - s["start"]) / 60))


# ---------- activity sampling (no permissions needed) ----------

def hid_idle_seconds():
    out = subprocess.run(["ioreg", "-c", "IOHIDSystem", "-d", "4", "-r"], capture_output=True, text=True, timeout=10).stdout
    m = re.search(r'"HIDIdleTime" = (\d+)', out)
    return int(m.group(1)) / 1e9 if m else None


def front_app():
    asn = subprocess.run(["lsappinfo", "front"], capture_output=True, text=True, timeout=10).stdout.strip()
    if not asn:
        return None
    out = subprocess.run(["lsappinfo", "info", "-only", "name", asn], capture_output=True, text=True, timeout=10).stdout
    m = re.search(r'"LSDisplayName"="(.*)"', out)
    return m.group(1) if m else None


def clean_domain(d):
    """Keep only a hostname, never a path or query."""
    d = str(d or "").strip().lower()
    return d if re.fullmatch(r"[a-z0-9.-]{1,253}", d) else None


class Recorder:
    """Appends samples and extension events to the session's jsonl file."""

    def __init__(self, path, enabled=True):
        self.path = path
        self.enabled = enabled
        self.lock = threading.Lock()
        self.domain = None

    def write(self, ev):
        if not self.enabled:
            return
        ev.setdefault("t", round(now(), 1))
        with self.lock, open(self.path, "a") as f:
            f.write(json.dumps(ev) + "\n")

    def tab(self, domain):
        domain = clean_domain(domain)
        if domain and domain != self.domain:
            self.domain = domain
            self.write({"type": "tab", "domain": domain})

    def hit(self, domain, kind):
        self.write({"type": "hit", "domain": clean_domain(domain) or "?", "kind": str(kind)[:20]})

    def sample(self):
        try:
            idle, app = hid_idle_seconds(), front_app()
        except Exception as e:
            return self.write({"type": "error", "error": str(e)[:200]})
        self.write({"type": "sample", "every": SAMPLE_EVERY, "idle_s": None if idle is None else round(idle, 1),
                    "active": idle is not None and idle < ACTIVE_WITHIN, "app": app,
                    "domain": self.domain if app == CHROME else None})


# ---------- watchdog ----------

def spawn_watchdog(cfg):
    """Double fork + setsid so the watchdog survives the terminal closing. Returns its pid."""
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(r)
        os.setsid()
        pid2 = os.fork()
        if pid2:
            os.write(w, str(pid2).encode())
            os._exit(0)
        os.close(w)
        fd = os.open(cfg.wdlog, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        nul = os.open(os.devnull, os.O_RDONLY)
        os.dup2(nul, 0)
        os.dup2(fd, 1)
        os.dup2(fd, 2)
        args = [sys.executable, os.path.realpath(__file__), "_watchdog"] + (["--dry-run"] if cfg.dry else [])
        os.execv(sys.executable, args)
    os.close(w)
    data = os.read(r, 32)
    os.close(r)
    os.waitpid(pid, 0)
    return int(data)


def serve_state(cfg, rec):
    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            s = read_json(cfg.session)
            running = bool(s) and now() < s["end"]
            self.reply(json.dumps({"active": running, "sampling": running,
                                   "goal": s.get("goal") if running else None,
                                   "end_ts": s.get("end") if running else None}).encode())

        def do_POST(self):
            # The custom header forces a CORS preflight, which this server never approves,
            # so ordinary web pages cannot post here; the extension can.
            if self.headers.get("X-Deepwork") != "1":
                return self.reply(b"{}", 403)
            try:
                n = min(int(self.headers.get("Content-Length") or 0), 4096)
                data = json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                return self.reply(b"{}", 400)
            if self.path == "/tab":
                rec.tab(data.get("domain"))
            elif self.path == "/hit":
                rec.hit(data.get("domain"), data.get("kind", "block"))
            else:
                return self.reply(b"{}", 404)
            self.reply(b"{}")

        def reply(self, body, code=200):
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass

    class S(socketserver.ThreadingMixIn, http.server.HTTPServer):
        daemon_threads = True
        allow_reuse_address = True

    try:
        srv = S(("127.0.0.1", cfg.port), H)
    except OSError as e:
        return print("%s endpoint not started on port %d: %s" % (iso(now()), cfg.port, e), flush=True)
    threading.Thread(target=srv.serve_forever, daemon=True).start()


def sampler(cfg, rec):
    while os.path.exists(cfg.session):
        rec.sample()
        time.sleep(SAMPLE_EVERY)


def watchdog(cfg):
    signal.signal(signal.SIGTERM, lambda *a: os._exit(0))
    print("%s watchdog %d up" % (iso(now()), os.getpid()), flush=True)
    s0 = read_json(cfg.session) or {}
    rec = Recorder(s0.get("samples_path") or os.path.join(cfg.sessions, "unknown.jsonl"), cfg.tracking)
    serve_state(cfg, rec)
    if cfg.tracking:
        threading.Thread(target=sampler, args=(cfg, rec), daemon=True).start()
    if cfg.web.enabled and s0:
        try:
            cfg.web.active(s0)
        except Exception as e:
            print("%s couldn't show the session on deepwork.garden: %s" % (iso(now()), e), flush=True)
    while True:
        s = read_json(cfg.session)
        if not s:
            return
        if now() >= s["end"]:
            if claim_and_restore(cfg, "timer"):
                if s.get("from_web"):
                    shutdown(cfg, True)
                    act(cfg, "notify", "Time is up: %s. Rate it on deepwork.garden." % s.get("goal"))
                elif pid_alive(s.get("fg_pid")):  # the terminal that started it runs the shutdown itself
                    act(cfg, "notify", "Time is up: %s." % s.get("goal"))
                else:
                    act(cfg, "notify", "Time is up: %s. Run deepwork off for the shutdown." % s.get("goal"))
                    act(cfg, "terminal", shutdown_command(cfg))
            return
        for a in cfg.apps:
            act(cfg, "quit", a)
        time.sleep(min(REQUIT_EVERY, max(0.2, s["end"] - now())))


# ---------- CLI ----------

def edit_config(cfg):
    if not os.path.exists(cfg.config):
        os.makedirs(os.path.dirname(cfg.config), exist_ok=True)
        write_json(cfg.config, cfg.conf)
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or next(
        (e for e in ("nvim", "vim", "vi") if shutil.which(e)), "vi")
    while True:
        subprocess.run(editor + " " + shlex.quote(cfg.config), shell=True)
        try:
            with open(cfg.config) as f:
                json.load(f)
            return print("Saved %s. Takes effect on the next deepwork start." % cfg.config)
        except ValueError as e:
            if not yes("That isn't valid JSON (%s). Edit again?" % e):
                return print("Left as is; deepwork uses the defaults until it parses.")


def main(argv):
    flags = {"--dry-run", "-y", "--yes", "--all", "-d", "--detach", "--from-web"}
    goal, rest, i = None, [], 0
    while i < len(argv):
        if argv[i] in ("-g", "--goal") and i + 1 < len(argv):
            goal = argv[i + 1]
            i += 2
            continue
        if argv[i] not in flags:
            rest.append(argv[i])
        i += 1
    dry, assume_yes = "--dry-run" in argv, "-y" in argv or "--yes" in argv
    cfg = Cfg(dry)
    cmd = rest[0] if rest else str(DEFAULT_MIN)
    if cmd == "_watchdog":
        return watchdog(cfg)
    if cmd == "off":
        return off(cfg, assume_yes)
    if cmd == "status":
        return status(cfg)
    if cmd in ("stats", "score"):
        return stats(cfg, "--all" in argv)
    if cmd == "capture":
        text = " ".join(rest[1:]).strip()
        if not text:
            sys.exit('usage: deepwork capture "<thought>"')
        append_capture(cfg, text)
        return print("Captured.")
    if cmd == "sync":
        if not (cfg.database_url or cfg.web.enabled):
            sys.exit('Nowhere to sync. Run deepwork login, or add "database_url" with: deepwork questions')
        try:
            if cfg.database_url:
                print("Synced %d session(s) to the database." % cfg.store.sync())
            if cfg.web.enabled:
                print("Synced %d session(s) to deepwork.garden." % cfg.web.sync(cfg.store.local()))
            return
        except Exception as e:
            sys.exit("Sync failed: %s" % e)
    if cmd == "login":
        return login(cfg, rest[1] if len(rest) > 1 else os.environ.get("DEEPWORK_SERVER", DEFAULT_SERVER))
    if cmd == "agent":
        return agent_ctl(cfg, rest[1] if len(rest) > 1 else "run")
    if cmd == "logout":
        rm(cfg.credentials)
        return print("Disconnected this terminal from deepwork.garden.")
    if cmd == "whoami":
        if not cfg.web.enabled:
            return print("Not connected. Run: deepwork login")
        try:
            return print("%s on %s" % (cfg.web.call("GET", "/api/cli/whoami")[1].get("email"), cfg.web.server))
        except Exception as e:
            sys.exit(str(e))
    if cmd in ("questions", "edit"):
        return edit_config(cfg)
    if cmd == "config":
        print("# %s%s" % (cfg.config, "" if os.path.exists(cfg.config) else " (not created yet; defaults below)"))
        return print(json.dumps(cfg.conf, indent=2))
    if cmd in ("help", "-h", "--help"):
        return print(__doc__)
    try:
        minutes = float(cmd)
    except ValueError:
        sys.exit("unknown command %r. Try: deepwork help" % cmd)
    if minutes <= 0 or (minutes < 1 and not dry):
        sys.exit("minutes must be at least 1")
    start(cfg, minutes, assume_yes, goal, detach="-d" in argv or "--detach" in argv, from_web="--from-web" in argv)


if __name__ == "__main__":
    main(sys.argv[1:])
