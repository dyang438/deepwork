#!/usr/bin/python3
"""deepwork: timed deep work sessions on macOS.

  deepwork [min]          start a session (default 90 minutes)
  deepwork off            end the session now and run the shutdown questions
  deepwork status         show the current session
  deepwork stats          deep hours today, this week, per goal (--all includes everyone in the store)
  deepwork capture "..."  append a stray thought to the capture file
  deepwork sync           push the local log to deepwork.garden and/or the database (database_url in settings)
  deepwork login [url]    connect this terminal to your deepwork.garden account (default https://deepwork.garden)
  deepwork logout         forget that connection
  deepwork whoami         show which account this terminal is connected to
  deepwork agent install  start blocks from deepwork.garden: runs a small agent at login (uninstall / status too)
  deepwork questions      edit your settings in $EDITOR
  deepwork config         print your settings
Flags: -y (skip questions), -g "goal", -d (return right away instead of counting down here), --dry-run (no apps quit, no DND, isolated state in ~/.deepwork-dryrun).
"""
