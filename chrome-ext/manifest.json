{
  "manifest_version": 3,
  "name": "deepwork",
  "version": "3.0.0",
  "description": "Covers YouTube and streaming sites unless the video is informative, and hides X and LinkedIn feeds, only while a deepwork session is running. Reports active-tab domains to the local deepwork sampler; a covered page's URL and title go to it only to judge the video.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:47615/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "feeds.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*",
        "https://netflix.com/*",
        "https://*.netflix.com/*",
        "https://twitch.tv/*",
        "https://*.twitch.tv/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*",
        "https://hulu.com/*",
        "https://*.hulu.com/*",
        "https://disneyplus.com/*",
        "https://*.disneyplus.com/*",
        "https://max.com/*",
        "https://*.max.com/*",
        "https://hbomax.com/*",
        "https://*.hbomax.com/*",
        "https://peacocktv.com/*",
        "https://*.peacocktv.com/*",
        "https://paramountplus.com/*",
        "https://*.paramountplus.com/*",
        "https://tv.apple.com/*",
        "https://*.tv.apple.com/*",
        "https://crunchyroll.com/*",
        "https://*.crunchyroll.com/*",
        "https://vimeo.com/*",
        "https://*.vimeo.com/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
